# How the Proxmox node reaches each pot VM as root: its own key, kept on the node. Read by lib/providers/proxmox.sh and prepended to proxmox/ensure-vm.sh.
PROXMOX_VM_KEY=/root/.ssh/pots-vm_ed25519
PROXMOX_VM_KNOWN_HOSTS=/root/.ssh/pots-vm_known_hosts
PROXMOX_VM_SSH_OPTIONS="-i $PROXMOX_VM_KEY -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=10 -o UserKnownHostsFile=$PROXMOX_VM_KNOWN_HOSTS"
PROXMOX_GUEST_TAG=pots
# Public resolvers: Docker hands session containers the VM's upstream resolvers, and the VM firewall drops their traffic to private ranges.
PROXMOX_VM_NAMESERVERS="1.1.1.1 9.9.9.9"
