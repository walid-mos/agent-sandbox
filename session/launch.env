POTS_SESSION_IMAGE=lscr.io/linuxserver/webtop:debian-xfce@sha256:4ec1d3cfb8df2e6e1c9d73c25bc1c8b42947e6861c3ef6a22e68b2f4cc94699f
POTS_SESSION_RUNTIME=sysbox-runc
POTS_SESSION_LABEL=fr.nextnode.pots=session
POTS_SESSION_SHM=1g
POTS_SESSION_START_DOCKER=false
POTS_SESSION_TIMEZONE=Europe/Paris
POTS_SESSION_CONTAINER=pots-session
POTS_SESSION_USER=abc
POTS_SESSION_INIT_SERVICE=init-services
POTS_SESSION_HOME=/config
POTS_HOME_VOLUME=pots-home
POTS_INNER_DOCKER_VOLUME=pots-inner-docker
POTS_SESSION_REPOSITORY=/opt/agent-sandbox
POTS_SESSION_CONFIGURATION=/etc/agent-sandbox
POTS_SOURCE_URL=https://github.com/walid-mos/agent-sandbox.git
POTS_TRUSTED_SOURCE=/usr/local/lib/agent-sandbox
POTS_TRUSTED_SIGNERS=/etc/agent-sandbox/trusted-signers.asc
POTS_RECEIVER=/var/lib/pots-receiver
POTS_ADMISSION=/opt/pots-admission
POTS_RELEASE_ID=/opt/pots-release-id
POTS_SESSION_LOCK_PATH=/run/pots-session.lock
POTS_ROUTER_DEFAULT_ADDRESS=127.0.0.1:3425
POTS_VAULT_IDENTITY=/etc/pots-vault/identity.json
POTS_VAULT_SOCKET=/run/pots-vault/vault.sock
POTS_SESSION_VAULT_DIRECTORY=.config/agent-secrets
POTS_SESSION_VAULT_FILE=session.env
POTS_LANDING_KEY_HOME=/etc/pots-landing/gnupg
POTS_LANDING_STATE=/var/lib/pots-landing
POTS_LANDING_SOCKET=/run/pots-landing/signer.sock
POTS_FACTORY_CONTAINER=pots-factory
POTS_FACTORY_HOME_VOLUME=pots-factory-home
POTS_FACTORY_DOCKER_VOLUME=pots-factory-docker
POTS_FACTORY_NETWORK=pots-factory
POTS_FACTORY_UID=1000
POTS_FACTORY_STATE=/var/lib/pots-factory
POTS_FACTORY_BOOTSTRAP=/run/pots-factory/bootstrap
POTS_FACTORY_REPORT_SOCKET=/run/pots-factory-reports/reports.sock
POTS_LANDING_REPOSITORY=walid-mos/agent-sandbox
POTS_LANDING_SQUASH_ENROLLED=0
POTS_FACTORY_REPORT_SOURCE=pr-factory
POTS_SIGNING_FACTORY_BOT=nextnode
