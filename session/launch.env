POTS_SESSION_IMAGE=lscr.io/linuxserver/webtop:debian-xfce@sha256:4ec1d3cfb8df2e6e1c9d73c25bc1c8b42947e6861c3ef6a22e68b2f4cc94699f
POTS_SESSION_RUNTIME=sysbox-runc
POTS_SESSION_LABEL=fr.nextnode.pots=session
POTS_SESSION_SHM=1g
POTS_SESSION_START_DOCKER=false
POTS_SESSION_TIMEZONE=Europe/Paris
POTS_SESSION_CONTAINER=pots-session
POTS_SESSION_USER=abc
POTS_SESSION_HOME=/config
POTS_HOME_VOLUME=pots-home
POTS_INNER_DOCKER_VOLUME=pots-inner-docker
