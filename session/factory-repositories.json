  "NextNodeSolutions/pi-agent": [
    { "name": "install", "run": ["pnpm", "install", "--frozen-lockfile"], "network": true },
    { "name": "lint", "run": ["pnpm", "run", "lint"] },
    { "name": "type-check", "run": ["pnpm", "run", "type-check"] },
