#!/usr/bin/env python3
import json
import os
import stat
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
LAUNCH = dict(line.split("=", 1) for line in (HERE / "launch.env").read_text().splitlines() if line)
DIRECTORY = LAUNCH["POTS_SESSION_VAULT_DIRECTORY"]
CREDENTIAL_NAMES = ("INFISICAL_API_URL", "INFISICAL_UNIVERSAL_AUTH_CLIENT_ID", "INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET")
INPUT_LIMIT_BYTES = 65536
PRIVATE_DIRECTORY = 0o700
PRIVATE_FILE = 0o600
PATH_REFUSAL = "store-identity: expected session-owned directories and regular shell hooks without symlinks. Repair the session home and rerun bin/session-credentials."


def read_payload():
    text = sys.stdin.read(INPUT_LIMIT_BYTES + 1)
    if len(text) > INPUT_LIMIT_BYTES:
        raise ValueError()
    payload = json.loads(text)
    credentials, binding = payload["credentials"], payload["binding"]
    if set(payload) != {"credentials", "binding"} or set(binding) != {"domain", "identityId", "projectId", "environment"} or sorted(credentials) != sorted(CREDENTIAL_NAMES):
        raise ValueError()
    words = [*credentials.values(), *(binding[key] for key in ("domain", "identityId", "projectId", "environment"))]
    if not all(isinstance(word, str) and word and not any(character.isspace() for character in word) for word in words):
        raise ValueError()
    if not binding["domain"].startswith("https://") or credentials["INFISICAL_API_URL"] != binding["domain"]:
        raise ValueError()
    return credentials, binding


def owned_directory(name, parent=None):
    descriptor = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
    if os.fstat(descriptor).st_uid != os.getuid():
        os.close(descriptor)
        raise SystemExit(PATH_REFUSAL)
    return descriptor


def child_directory(name, parent):
    try:
        os.mkdir(name, PRIVATE_DIRECTORY, dir_fd=parent)
    except FileExistsError:
        pass
    return owned_directory(name, parent)


def directory_descriptor():
    descriptor = owned_directory(os.environ["HOME"])
    try:
        for component in Path(DIRECTORY).parts:
            nested = child_directory(component, descriptor)
            os.close(descriptor)
            descriptor = nested
        os.fchmod(descriptor, PRIVATE_DIRECTORY)
        return descriptor
    except BaseException:
        os.close(descriptor)
        raise


def replace_file(name, text, directory_descriptor, unique=0):
    pending = f".{name}.{os.getpid()}.{unique}.next"
    try:
        descriptor = os.open(pending, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, PRIVATE_FILE, dir_fd=directory_descriptor)
        with os.fdopen(descriptor, "w") as file:
            file.write(text)
        os.replace(pending, name, src_dir_fd=directory_descriptor, dst_dir_fd=directory_descriptor)
    finally:
        try:
            os.unlink(pending, dir_fd=directory_descriptor)
        except FileNotFoundError:
            pass


def install_credentials(directory_descriptor, credentials, binding):
    payloads = {LAUNCH["POTS_SESSION_VAULT_FILE"]: "".join(f"{name}={value}\n" for name, value in credentials.items()), "core-vault.json": f"{json.dumps(binding)}\n"}
    for unique, (name, text) in enumerate(payloads.items()):
        replace_file(name, text, directory_descriptor, unique)


def install_shell_hook(name, home):
    descriptor = os.open(name, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK, PRIVATE_FILE, dir_fd=home)
    with os.fdopen(descriptor, "r+") as output:
        details = os.fstat(output.fileno())
        if not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid() or details.st_nlink != 1:
            raise SystemExit(PATH_REFUSAL)
        os.fchmod(output.fileno(), PRIVATE_FILE)
        hook = f'. "{LAUNCH["POTS_SESSION_REPOSITORY"]}/session/lib.sh"'
        if hook not in output.read().splitlines():
            output.seek(0, os.SEEK_END)
            output.write(f"\n{hook}\n")


def install_shell_hooks():
    home = owned_directory(os.environ["HOME"])
    try:
        for name in (".profile", ".bashrc"):
            install_shell_hook(name, home)
    finally:
        os.close(home)


def main():
    credentials, binding = read_payload()
    try:
        descriptor = directory_descriptor()
    except SystemExit:
        raise
    except OSError:
        raise SystemExit(PATH_REFUSAL) from None
    try:
        install_credentials(descriptor, credentials, binding)
    finally:
        os.close(descriptor)
    install_shell_hooks()
    print("store-identity: installed the session login and vault binding, mode 600, with shell hooks.")


try:
    main()
except OSError:
    raise SystemExit(PATH_REFUSAL) from None
except Exception:
    raise SystemExit("store-identity: installation failed. Check the input, session home and permissions; rerun bin/session-credentials.") from None
