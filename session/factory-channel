#!/usr/bin/env python3
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from factory_socket import ask
from launch import LAUNCH

SOCKETS = {"landing": LAUNCH["POTS_LANDING_SOCKET"], "reports": LAUNCH["POTS_FACTORY_REPORT_SOCKET"]}
REQUEST_LIMIT = 16384


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in SOCKETS:
        raise ValueError("expected landing or reports")
    request = sys.stdin.buffer.read(REQUEST_LIMIT + 1)
    if len(request) > REQUEST_LIMIT:
        raise ValueError("request exceeds the protocol limit")
    sys.stdout.write(json.dumps(ask(SOCKETS[sys.argv[1]], json.loads(request))) + "\n")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError) as error:
        raise SystemExit(f"factory-channel: {error}") from None
