#!/usr/bin/env python3
import json
from pathlib import Path
import socket
import sys

LAUNCH = dict(line.split("=", 1) for line in (Path(__file__).resolve().parent / "launch.env").read_text().splitlines() if line)
SOCKETS = {"landing": LAUNCH["POTS_LANDING_SOCKET"], "reports": LAUNCH["POTS_FACTORY_REPORT_SOCKET"]}
TOKEN_FILE = "token"
REQUEST_LIMIT = 16384
RESPONSE_LIMIT = 65536


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in SOCKETS:
        raise ValueError("expected landing or reports")
    request = sys.stdin.buffer.read(REQUEST_LIMIT + 1)
    if len(request) > REQUEST_LIMIT:
        raise ValueError("request exceeds the protocol limit")
    request = (json.dumps(json.loads(request)) + "\n").encode()
    # The VM writes this token into the socket's directory, which only the isolated factory mounts.
    credential = (Path(SOCKETS[sys.argv[1]]).parent / TOKEN_FILE).read_bytes()
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(150)
        connection.connect(SOCKETS[sys.argv[1]])
        connection.sendall(credential + request)
        connection.shutdown(socket.SHUT_WR)
        with connection.makefile("rb") as incoming:
            response = incoming.readline(RESPONSE_LIMIT + 1)
    if len(response) > RESPONSE_LIMIT or not response.endswith(b"\n"):
        raise ValueError("unreadable service response")
    reply = json.loads(response)
    if reply.get("ok") is not True:
        raise ValueError(reply.get("error", "service refused the operation"))
    sys.stdout.write(json.dumps(reply) + "\n")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError) as error:
        raise SystemExit(f"factory-channel: {error}") from None
