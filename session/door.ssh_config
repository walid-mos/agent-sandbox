Host *-host
	User door
	IdentityFile ~/.config/agent-sandbox/door/id_ed25519
	IdentitiesOnly yes
	UserKnownHostsFile ~/.config/agent-sandbox/door/known_hosts
	GlobalKnownHostsFile /dev/null
	StrictHostKeyChecking yes
	UpdateHostKeys no
	CheckHostIP no
	HostKeyAlgorithms ssh-ed25519
	BatchMode yes
	ProxyCommand /opt/agent-sandbox/session/door-dial %h
	ClearAllForwardings yes
	ForwardAgent no
	ForwardX11 no
	RequestTTY no
	ServerAliveInterval 15
	ServerAliveCountMax 2
	LogLevel ERROR
