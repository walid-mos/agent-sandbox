#!/bin/sh
set -eu
. "$(dirname "$0")/lib.sh"

REQUIRED_NAMES="INFISICAL_API_URL INFISICAL_UNIVERSAL_AUTH_CLIENT_ID INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET"
target="$POTS_VAULT_CREDENTIALS"

umask 077
mkdir -p "$(dirname "$target")"
cat > "$target.tmp"
for name in $REQUIRED_NAMES; do
	if ! grep -q "^$name=." "$target.tmp"; then
		rm -f "$target.tmp"
		echo "store-credentials: $name missing from the input; nothing stored" >&2
		exit 1
	fi
done
mv "$target.tmp" "$target"
