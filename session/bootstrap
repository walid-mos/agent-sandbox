#!/bin/sh
set -eu
here=$(cd "$(dirname "$0")" && pwd)
. "$here/lib.sh"
. "$here/../lib/tailscale.sh"

NODE_VERSION=v24.22.3
GH_VERSION=2.104.0
INFISICAL_VERSION=0.45.10
# The release-wide checksums file's own sha256, fetched 2026-11-17; a new INFISICAL_VERSION needs its new value.
INFISICAL_CHECKSUMS_SHA256=cb92960eb47f041ead7b3fc60e48f2642badd11b0f712696cfa8be33a69ddf5f
MAGPIE_VERSION=0.1.4340
CODEX_VERSION=0.169.1
MAGPIE_RELEASES=https://github.com/yetone/magpie-releases/releases/download
CLAUDE_CODE_VERSION=2.1.325
POTS_PACKAGE=pi-durable-bot
architecture=$(dpkg --print-architecture)
# Node names its 64-bit Intel build x64, and every other release here calls it amd64.
case "$architecture" in
	arm64) node_architecture=arm64 ;;
	amd64) node_architecture=x64 ;;
	*) echo "session/bootstrap: no pinned tools for the $architecture architecture; add its release names beside NODE_VERSION" >&2; exit 1 ;;
esac

staging=
# The keeper reruns a failed install every minute, so the staging directory of the install in progress goes when the script exits, on success or failure; a signal that kills the shell skips the trap.
trap '[ -z "$staging" ] || rm -rf "$staging"' EXIT

download_verified() {
	archive_url=$1 sums_url=$2 download_directory=$3
	archive=$(basename "$archive_url")
	(
		cd "$download_directory"
		curl --fail --silent --show-error --location --max-time "$DOWNLOAD_MAX_SECONDS" --remote-name "$archive_url"
		sums_lines "$sums_url" | grep " \*\?$archive\$" | sed 's/ \*/  /' | sha256sum --check --quiet
	)
}

sums_lines() {
	if [ -f "$1" ]; then
		cat -- "$1"
	else
		curl --fail --silent --show-error --location --max-time "$DOWNLOAD_MAX_SECONDS" "$1"
	fi
}

install_node() {
	if [ "$(node --version 2> /dev/null)" = "$NODE_VERSION" ]; then return 0; fi
	staging=$(mktemp -d)
	download_verified "https://nodejs.org/dist/$NODE_VERSION/node-$NODE_VERSION-linux-$node_architecture.tar.gz" \
		"https://nodejs.org/dist/$NODE_VERSION/SHASUMS256.txt" "$staging"
	rm -rf "$POTS_TOOLS/node"
	mkdir -p "$POTS_TOOLS/node"
	tar -xzf "$staging"/node-*.tar.gz -C "$POTS_TOOLS/node" --strip-components 1
	rm -rf "$staging"
}

install_release_binary() {
	destination=$1 version=$2 archive_url=$3 sums_url=$4 member=$5 pinned_sums=${6:-}
	if "$destination" --version 2> /dev/null | grep -q "$version"; then return 0; fi
	staging=$(mktemp -d)
	if [ -n "$pinned_sums" ]; then
		(
			cd "$staging"
			curl --fail --silent --show-error --location --max-time "$DOWNLOAD_MAX_SECONDS" --remote-name "$sums_url"
			echo "$pinned_sums  $(basename "$sums_url")" | sha256sum --check --quiet
		)
		download_verified "$archive_url" "$staging/$(basename "$sums_url")" "$staging"
	else
		download_verified "$archive_url" "$sums_url" "$staging"
	fi
	tar -xzf "$staging"/*.tar.gz -C "$staging" "$member"
	install -D -m 0755 "$staging/$member" "$destination"
	rm -rf "$staging"
}

install_cli_tools() {
	install_release_binary "$POTS_GH" "$GH_VERSION" \
		"https://github.com/cli/cli/releases/download/v$GH_VERSION/gh_${GH_VERSION}_linux_$architecture.tar.gz" \
		"https://github.com/cli/cli/releases/download/v$GH_VERSION/gh_${GH_VERSION}_checksums.txt" \
		"gh_${GH_VERSION}_linux_$architecture/bin/gh"
	install_release_binary "$POTS_TOOLS/bin/infisical" "$INFISICAL_VERSION" \
		"https://github.com/Infisical/cli/releases/download/v$INFISICAL_VERSION/cli_${INFISICAL_VERSION}_linux_$architecture.tar.gz" \
		"https://github.com/Infisical/cli/releases/download/v$INFISICAL_VERSION/checksums.txt" \
		infisical "$INFISICAL_CHECKSUMS_SHA256"
}

install_tailscale() {
	if tailscale_is_current "$POTS_TOOLS/bin/tailscale" "$POTS_TOOLS/bin/tailscaled"; then return 0; fi
	staging=$(mktemp -d)
	tailscale_unpack "$architecture" "$staging"
	install -D -m 0755 "$staging/tailscale" "$POTS_TOOLS/bin/tailscale"
	install -D -m 0755 "$staging/tailscaled" "$POTS_TOOLS/bin/tailscaled"
	rm -rf "$staging"
}

router_installed() {
	magpie --version 2> /dev/null | grep -qx "magpie $MAGPIE_VERSION"
}

install_router() {
	if router_installed; then return 0; fi
	binary=magpie-cli-linux-$architecture
	staging=$(mktemp -d)
	download_verified "$MAGPIE_RELEASES/v$MAGPIE_VERSION/$binary" "$MAGPIE_RELEASES/v$MAGPIE_VERSION/SHA256SUMS" "$staging"
	install -D -m 0755 "$staging/$binary" "$POTS_TOOLS/bin/magpie.next"
	mv -f "$POTS_TOOLS/bin/magpie.next" "$POTS_TOOLS/bin/magpie"
	rm -rf "$staging"
}

codex_installed() {
	codex --version 2> /dev/null | grep -qx "codex-cli $CODEX_VERSION"
}

# Magpie reads the installed Codex version for account model lists and requests.
install_codex() {
	if codex_installed; then return 0; fi
	env -i HOME="$HOME" PATH="$PATH" NPM_CONFIG_PREFIX="$NPM_CONFIG_PREFIX" \
		HTTP_PROXY="${HTTP_PROXY:-}" HTTPS_PROXY="${HTTPS_PROXY:-}" ALL_PROXY="${ALL_PROXY:-}" NO_PROXY="${NO_PROXY:-}" \
		http_proxy="${http_proxy:-}" https_proxy="${https_proxy:-}" all_proxy="${all_proxy:-}" no_proxy="${no_proxy:-}" \
		SSL_CERT_FILE="${SSL_CERT_FILE:-}" SSL_CERT_DIR="${SSL_CERT_DIR:-}" NODE_EXTRA_CA_CERTS="${NODE_EXTRA_CA_CERTS:-}" \
		npm install --global --ignore-scripts --no-fund --no-audit "@openai/codex@$CODEX_VERSION"
}

# The router answers for Claude models by running this Claude Code.
install_claude_code() {
	if claude --version 2> /dev/null | grep -q "$CLAUDE_CODE_VERSION"; then return 0; fi
	npm install --global --no-fund --no-audit "@anthropic-ai/claude-code@$CLAUDE_CODE_VERSION"
}

configure_git() {
	identity=/etc/agent-sandbox/git-identity.json
	if [ -f "$identity" ]; then
		git config --global user.name "$(node -p "require('$identity').name")"
		git config --global user.email "$(node -p "require('$identity').email")"
	fi
	git config --global credential.https://github.com.useHttpPath true
	git config --global --replace-all credential.https://github.com.helper "!node $here/github.mjs credential"
}

install_pots() {
	if [ ! -x "$POTS_UPSTREAM" ]; then
		npm install --global --prefix "${POTS_UPSTREAM%/bin/pots}" --no-fund --no-audit "$POTS_PACKAGE@latest"
	fi
	ln -sf "$here/pots" "$POTS_TOOLS/bin/pots"
}

install_harness() {
	harness_dir="$HOME/$(node -p "require('$here/agent-sources.json').pi.directory")"
	[ -f "$harness_dir/package.json" ] || { echo "bootstrap: the Pi harness is missing at $harness_dir. Select pi under sources in sandbox.json, then run bin/vm-config." >&2; exit 1; }
	pi_version=$(node -p "require('$harness_dir/package.json').devDependencies['@earendil-works/pi-coding-agent']")
	npm install --global --no-fund --no-audit "@earendil-works/pi-coding-agent@$pi_version"
}

router_tools_installed() {
	router_installed && codex_installed
}

install_router_tools() {
	install_router
	install_codex
}

case "${1:-}" in
	--router-current)
		router_tools_installed &&
			curl --silent --fail --max-time 5 "http://$POTS_ROUTER_ADDRESS/api/hello" | jq --exit-status --arg version "$MAGPIE_VERSION" '.version == $version' > /dev/null
		exit $? ;;
	--router-only) install_router_tools; exit ;;
esac

install_node
install_cli_tools
install_tailscale
install_router_tools
install_claude_code
ln -sf "$here/gh" "$POTS_TOOLS/bin/gh"
configure_git
install_pots
npm install --global --no-fund --no-audit pnpm
node "$here/provision-runtime.mjs" "$POTS_ROUTER_API"
"$here/provision-agents"
install_harness
