#!/bin/sh
set -eu
. "$(dirname "$0")/../lib/sandbox.sh"
require_sealskin

local_port=${1:-}
session_port=${2:-$local_port}
for port in "$local_port" "$session_port"; do
	case "$port" in '' | *[!0-9]*) echo 'usage: forward-dev LOCAL_PORT [SESSION_PORT]' >&2; exit 2 ;; esac
	[ "$port" -gt 0 ] && [ "$port" -le 65535 ] || { echo 'forward-dev: ports must be between 1 and 65535' >&2; exit 2; }
done
session=$(running_session)
address=$(sandbox_docker inspect --format "{{(index .NetworkSettings.Networks \"$POTS_SERVER_NETWORK\").IPAddress}}" "$session")
exec ssh -F "$HOME/.colima/_lima/colima-$POTS_PROFILE/ssh.config" \
	-o ControlMaster=no -o ControlPath=none -o ExitOnForwardFailure=yes \
	-N -L "127.0.0.1:$local_port:$address:$session_port" "lima-colima-$POTS_PROFILE"
