#!/usr/bin/env python3
import json
import os
from pathlib import Path
import shlex
import sys

HOST = json.loads((Path.home() / ".config/agent-sandbox/host.json").read_text())
if len(sys.argv) != 3:
    raise SystemExit("usage: sealskin-connect sandbox shell-line")
sandbox, line = sys.argv[1:]
sandbox_exec = f'{HOST["remoteSandboxRepository"]}/bin/sandbox-exec'
remote = shlex.join(["env", f"SANDBOX={sandbox}", sandbox_exec, "sh", "-c", line])
os.execvp("ssh", ["ssh", "-T", "-o", "BatchMode=yes", HOST["connectHost"], remote])
