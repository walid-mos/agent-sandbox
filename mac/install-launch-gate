#!/usr/bin/env python3
import json
import os
import plistlib
import subprocess
import sys
from pathlib import Path

LABEL = "fr.nextnode.agent-sandbox.mac-launch"
DOMAIN = f"gui/{os.getuid()}"
REPOSITORY = Path(__file__).resolve().parents[1]
PLIST = Path.home() / "Library/LaunchAgents" / f"{LABEL}.plist"
LOG = Path.home() / "Library/Logs/agent-sandbox/mac-launch.log"
SETTINGS = Path.home() / ".config/agent-sandbox/mac-launch.json"


def install():
    if sys.platform != "darwin":
        raise SystemExit("mac-launch: install this service on its Mac only.")
    if sys.argv[1:] == ["--remove"]:
        subprocess.run(["launchctl", "bootout", f"{DOMAIN}/{LABEL}"], check=False)
        PLIST.unlink(missing_ok=True)
        print("Mac launch login service removed.")
        return
    if sys.argv[1:]:
        raise SystemExit("usage: mac/install-launch-gate [--remove]")
    settings = json.loads(SETTINGS.read_text())
    if settings.get("humanDiscord", {}).get("macLaunchEnabled") is not True:
        raise SystemExit("mac-launch: enable the private switch before installing.")
    PLIST.parent.mkdir(parents=True, exist_ok=True)
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with os.fdopen(os.open(LOG, os.O_CREAT | os.O_APPEND | os.O_WRONLY, 0o600), "a"):
        pass
    configuration = {
        "Label": LABEL,
        "ProgramArguments": [str(REPOSITORY / "mac/launch-gate"), "serve"],
        "WorkingDirectory": str(REPOSITORY),
        "EnvironmentVariables": {"PATH": ":".join(settings["path"] + ["/usr/bin", "/bin", "/usr/sbin", "/sbin"])},
        "RunAtLoad": True,
        "KeepAlive": {"SuccessfulExit": False},
        "ThrottleInterval": 30,
        "StandardOutPath": str(LOG),
        "StandardErrorPath": str(LOG),
    }
    PLIST.write_bytes(plistlib.dumps(configuration))
    os.chmod(PLIST, 0o600)
    subprocess.run(["launchctl", "bootstrap", DOMAIN, str(PLIST)], check=True)
    print("Mac launch service installed. No inbound port was opened.")


install()
