#!/bin/sh
set -eu
repo=$(cd "$(dirname "$0")/.." && pwd)
TRUNK=main
SIGNERS="${POTS_RUNTIME:-$HOME/.config/agent-sandbox}/trusted-signers.asc"
status=0

# The watchdog runs vm-up from this checkout, so a fetched commit lands only when an operator key in SIGNERS signed it.
advance() {
	git -C "$repo" fetch --quiet origin "$TRUNK" || return 1
	candidate=$(git -C "$repo" rev-parse --verify "FETCH_HEAD^{commit}") || return 1
	[ "$candidate" != "$(git -C "$repo" rev-parse HEAD)" ] || return 0
	python3 -I "$repo/lib/signed_commit.py" verify "$repo" "$candidate" "$SIGNERS" > /dev/null || return 1
	git -C "$repo" merge --quiet --ff-only "$candidate"
}

# A checkout on the trunk follows it, so a merge reaches this Mac with no command typed. Any other branch is the operator's choice and stays as it is.
if [ "$(git -C "$repo" symbolic-ref --quiet --short HEAD)" = "$TRUNK" ]; then
	before=$(git -C "$repo" rev-parse HEAD)
	advance || status=1
	[ "$(git -C "$repo" rev-parse HEAD)" = "$before" ] || echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) update: the checkout moved to $(git -C "$repo" log --oneline -1)"
fi
"$repo/bin/install-herdr" || status=1
exit "$status"
