#!/usr/bin/env python3
import os
import plistlib
import subprocess
from pathlib import Path

LABEL = "fr.nextnode.agent-sandbox"
DOMAIN = f"gui/{os.getuid()}"
REPOSITORY = Path(__file__).resolve().parents[1]
PLIST = Path.home() / "Library/LaunchAgents" / f"{LABEL}.plist"
LOG = Path.home() / "Library/Logs/agent-sandbox/watchdog.log"

LOG.parent.mkdir(parents=True, exist_ok=True)
PLIST.parent.mkdir(parents=True, exist_ok=True)
with os.fdopen(os.open(LOG, os.O_CREAT | os.O_APPEND | os.O_WRONLY, 0o600), "a"):
    pass
configuration = {
    "Label": LABEL,
    "ProgramArguments": [str(REPOSITORY / "mac/watchdog")],
    "WorkingDirectory": str(REPOSITORY),
    "RunAtLoad": True,
    "StartInterval": 60,
    "ThrottleInterval": 30,
    "KeepAlive": {"SuccessfulExit": False},
    "StandardOutPath": str(LOG),
    "StandardErrorPath": str(LOG),
}
subprocess.run(["launchctl", "bootout", f"{DOMAIN}/{LABEL}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
PLIST.write_bytes(plistlib.dumps(configuration))
os.chmod(PLIST, 0o600)
subprocess.run(["launchctl", "bootstrap", DOMAIN, str(PLIST)], check=True)
print(f"Installed {LABEL}: starts at login. Every minute it updates the checkout and the pane, and keeps each Colima VM and its SealSkin server running.")
