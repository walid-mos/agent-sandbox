{
  "launcher": "docker",
  "role": "mastermind",
  "vm": {
    "cpu": 2,
    "memoryGiB": 2,
    "swapGiB": 2,
    "diskGiB": 40
  },
  "bot": "Mastermind",
  "owners": {},
  "secrets": {
    "/providers": [
      "INCO_API_KEY",
      "OPENROUTER_API_KEY",
      "TYPESAFE_API_KEY"
    ]
  },
  "onRequest": {
    "router": {
      "/clients/pi": [
        "PI_OAUTH_CODEX"
      ]
    },
    "claude": {
      "/clients/claude": [
        "CLAUDE_CODE_OAUTH_TOKEN"
      ]
    }
  },
  "sources": [
    "pi",
    "herdr"
  ],
  "doors": {
    "nextnode": "NextNodeSolutions and walid-mos repositories, and their PR factory",
    "accor": "Accor client work, where every push waits for the person's yes",
    "personal": "personal budget and Twitter"
  }
}
