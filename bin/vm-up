#!/bin/sh
set -eu
. "$(dirname "$0")/../lib/sandbox.sh"

swap_gib=$(vm_setting swapGiB)
vm_start
scripts=$(vm_scripts)
sandbox_vm sudo "$scripts/setup.sh" "$swap_gib" "$POTS_LAUNCHER"
# Left unquoted: the provider's VARIABLE=VALUE words, none on Colima.
sandbox_vm "$scripts/session-keys" "$SANDBOX" "$POTS_VM_REPO/bin/sandbox-exec" $POTS_VM_ENTRY_ENVIRONMENT < "$HOME/.ssh/authorized_keys"
