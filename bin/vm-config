#!/bin/sh
set -eu
. "$(dirname "$0")/../lib/sandbox.sh"
[ "$POTS_TRANSPORT" = provider ] || refuse_inside_vm vm-config

set -- "$POTS_CONFIG" "$POTS_SANDBOX_DIR/vault.json"
[ ! -f "$POTS_SANDBOX_DIR/git-identity.json" ] || set -- "$@" "$POTS_SANDBOX_DIR/git-identity.json"
# The bundle is built before it is sent because sh has no pipefail to report a file that is not JSON.
bundle=$(jq --null-input 'reduce inputs as $content ({}; .[input_filename | split("/") | last] = $content)' "$@")
printf '%s\n' "$bundle" | sandbox_vm sudo python3 -I "$POTS_SESSION_REPOSITORY/vm/store-config" "$POTS_SESSION_CONFIGURATION"
