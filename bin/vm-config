#!/bin/sh
set -eu
. "$(dirname "$0")/../lib/sandbox.sh"
[ "$POTS_TRANSPORT" = provider ] || refuse_inside_vm vm-config

# Build before sending because sh has no pipefail to report a refused bundle.
bundle=$(python3 -B "$POTS_REPO/lib/config_bundle.py" "$POTS_SANDBOX_DIR" "$POTS_RUNTIME")
printf '%s\n' "$bundle" | run_trusted vm/store-config "$POTS_SESSION_CONFIGURATION"
