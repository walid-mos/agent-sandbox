#!/bin/sh
set -eu
. "$(dirname "$0")/../lib/sandbox.sh"
. "$POTS_REPO/vm/network.env"

REACH="$POTS_SESSION_REPOSITORY/probes/reach.sh"
SESSION_ATTACKS="$POTS_SESSION_REPOSITORY/probes/session-attacks.sh"
VAULT_ATTACKS="$POTS_SESSION_REPOSITORY/probes/vault-attacks.sh"
JIRA_AUTHENTICATION="$POTS_SESSION_REPOSITORY/probes/jira-authentication.mjs"
SESSION_NODE="$POTS_SESSION_HOME/.local/node/bin/node"
HOST_PATHS="$POTS_SESSION_REPOSITORY/vm/check-host-paths"
DOOR_DELIVERIES="$POTS_SESSION_REPOSITORY/probes/door-deliveries.sh"
LANDING_ATTACKS="$POTS_SESSION_REPOSITORY/probes/landing-attacks.sh"
TAILNET_ATTACKS="$POTS_SESSION_REPOSITORY/probes/tailnet-attacks.sh"
SESSION_TAILSCALE="$POTS_SESSION_HOME/.local/bin/tailscale"
DOOR_CLIENT_CONFIG="$POTS_SESSION_REPOSITORY/session/door.ssh_config"
DOOR_KNOWN_HOSTS="$POTS_SESSION_HOME/.config/agent-sandbox/door/known_hosts"
DOOR_FILES="/etc/pots-door /etc/sudoers.d/pots-door /etc/sudoers.d/pots-door-bindings /usr/local/sbin/pots-door /usr/local/sbin/pots-door-keys /usr/local/sbin/pots-door-serve"
SESSION_TAILNET_NODE="$POTS_SESSION_REPOSITORY/session/tailnet-node"
TAILNET_SERVICE_ADDRESS=100.100.100.100
TAILNET_ADDRESS='^(100\.[0-9.]+|\[fd7a:115c:a1e0:[0-9a-f:]*\])'
VM_SEALSKIN_CONFIG=/var/lib/docker/volumes/agent-sandbox_sealskin-config
TRUSTED_PATH=/usr/sbin:/usr/bin:/sbin:/bin
vm_tailnet_address=$(sandbox_vm tailscale ip -4)
operator_node=$(tailscale status --json --peers=false | jq -er '.Self.DNSName | split(".")[0]')

sealskin_endpoints() {
	[ "$POTS_LAUNCHER" = sealskin ] || return 0
	printf '%s:22 %s:8443 %s:8000 ' "$SEALSKIN_GATEWAY_ADDRESS" "$SEALSKIN_SERVER_ADDRESS" "$SEALSKIN_SERVER_ADDRESS"
}

provider_forbidden=$(vm_forbidden_endpoints)
forbidden="$provider_forbidden $vm_tailnet_address:22 $vm_tailnet_address:$DOOR_PORT $TAILNET_SERVICE_ADDRESS:53 $(sealskin_endpoints)"
allowed="registry.npmjs.org:443 github.com:443"

in_session() {
	session_exec "$session" env -i PATH="$TRUSTED_PATH" HOME="$POTS_SESSION_HOME" "$@"
}

in_session_as_root() {
	sandbox_docker exec --user root "$session" env -i PATH="$TRUSTED_PATH" HOME=/root "$@"
}

judge_forbidden() {
	views=$(mktemp -d)
	run_trusted probes/reach.sh $forbidden > "$views/vm" || { echo "FAIL vm-view (the trusted launcher did not run probes/reach.sh)"; rm -rf "$views"; return 1; }
	in_session bash "$REACH" $(awk '{ print $2 }' "$views/vm") > "$views/session"
	paste -d ' ' "$views/vm" "$views/session" | awk '
		$1 != "open" { print "FAIL untestable " $2 " (closed from the VM too)"; bad++; next }
		$3 == "open" { print "FAIL session-reaches " $2; bad++; next }
		{ print "ok   session-blocked " $2 }
		END { exit bad > 0 }'
	verdict=$?
	rm -rf "$views"
	return "$verdict"
}

judge_allowed() {
	in_session bash "$REACH" $allowed | awk '
		$1 != "open" { print "FAIL session-cannot-reach " $2; bad++; next }
		{ print "ok   session-reaches " $2 }
		END { exit bad > 0 }'
}

judge() {
	check=$1
	shift
	if "$@"; then
		echo "ok   $check"
	else
		echo "FAIL $check"
		return 1
	fi
}

family_closes_tailnet() {
	printf '%s\n' "$1" | awk -v drop="-A DOCKER-USER -o $TAILNET_LINKS -j DROP" '
		$0 == drop { dropped = NR }
		/^-A DOCKER-USER .*-j RETURN$/ && !returned { returned = NR }
		END { exit !(dropped && dropped < returned) }' || return 1
	printf '%s\n' "$1" | grep -q -- "^-A POTS-INPUT .*--dport $DOOR_PORT .*--connlimit-above" || return 1
	! printf '%s\n' "$1" | grep -q -- '^-N ts-'
}

firewall_closes_tailnet() {
	family_closes_tailnet "$(sandbox_vm sudo iptables -S)" && family_closes_tailnet "$(sandbox_vm sudo ip6tables -S)"
}

door_account_has_no_docker() {
	! sandbox_vm id -nG door | tr ' ' '\n' | grep -qx docker
}

peer_pots() {
	in_session awk '{ sub(/-host$/, "", $1); print $1 }' "$DOOR_KNOWN_HOSTS" 2> /dev/null || true
}

door_listens_on_tailnet_only() {
	listeners=$(sandbox_vm sudo ss -Hltn "sport = :$DOOR_PORT" | awk '{ print $4 }')
	[ -n "$listeners" ] && ! printf '%s\n' "$listeners" | grep -Evq "$TAILNET_ADDRESS:$DOOR_PORT\$"
}

door_files_digest() {
	sandbox_vm sudo find $DOOR_FILES -type f -exec sha256sum {} + | sort
}

guard_runs_every_minute() {
	sandbox_vm systemctl is-active --quiet pots-tailnet-guard.timer
}

# The door account may run the door with the arguments of a key installed for it, and with no caller it names itself.
door_sudo_takes_only_bindings() {
	bound=$(sandbox_vm cat /etc/pots-door/authorized_keys | sed -n 's|^restrict,command="/usr/bin/sudo -n \(/usr/local/sbin/pots-door [a-z0-9 -]*\)".*|\1|p' | head -n 1)
	[ -n "$bound" ] || return 1
	sandbox_vm sudo -u door sudo -n -l $bound > /dev/null || return 1
	! sandbox_vm sudo -u door sudo -n -l /usr/local/sbin/pots-door intruder "$SANDBOX" ask > /dev/null 2>&1
}

unit_lists() {
	sandbox_vm systemctl show "$1" --property "$2" --value | tr ' ' '\n' | grep -qx "$3"
}

refused() {
	! "$@" > /dev/null 2>&1
}

identity_is_root_only() {
	[ "$(sandbox_vm sudo stat -c '%U %a' "$POTS_VAULT_IDENTITY" "$(dirname "$POTS_VAULT_IDENTITY")" | tr '\n' ' ')" = 'root 600 root 700 ' ]
}

session=$(running_session)
status=0
if [ "$POTS_LAUNCHER" = sealskin ]; then
	judge control-vm-has-sealskin-config sandbox_vm sudo test -d "$VM_SEALSKIN_CONFIG" || status=1
	outer_container=$POTS_SERVER_CONTAINER
else
	outer_container=$POTS_SESSION_CONTAINER
fi
judge docker-requires-firewall unit_lists docker.service Requires pots-firewall.service || status=1
judge door-requires-firewall unit_lists pots-door.service Requires pots-firewall.service || status=1
judge vm-sees-no-host-path run_trusted vm/check-host-paths || status=1
judge session-sees-no-host-path in_session sh "$HOST_PATHS" || status=1
judge firewall-closes-tailnet firewall_closes_tailnet || status=1
judge door-listens-on-tailnet-only door_listens_on_tailnet_only || status=1
judge door-account-has-no-docker door_account_has_no_docker || status=1
judge door-sudo-takes-only-bindings door_sudo_takes_only_bindings || status=1
tailnet_targets="$operator_node $(peer_pots)"
judge host-node-matches-policy run_trusted lib/tailnet_node.py check host "$SANDBOX" $tailnet_targets || status=1
judge session-node-matches-policy in_session "$SESSION_TAILNET_NODE" check session "$SANDBOX" $tailnet_targets || status=1
judge tailnet-guard-runs-every-minute guard_runs_every_minute || status=1
judge refused-clone-raises-shields unit_lists pots-tailnet-guard.service OnFailure pots-shields-up.service || status=1
judge tailnet-guard-passes run_trusted vm/tailnet-guard || status=1
judge_forbidden || status=1
judge_allowed || status=1
in_session bash "$SESSION_ATTACKS" "$POTS_LAUNCHER" "$outer_container" "$SEALSKIN_SERVER_ADDRESS" "$VM_SEALSKIN_CONFIG" "$POTS_SESSION_REPOSITORY" "$POTS_SESSION_CONFIGURATION" || status=1
in_session_as_root bash "$SESSION_ATTACKS" "$POTS_LAUNCHER" "$outer_container" "$SEALSKIN_SERVER_ADDRESS" "$VM_SEALSKIN_CONFIG" "$POTS_SESSION_REPOSITORY" "$POTS_SESSION_CONFIGURATION" || status=1
in_session bash "$DOOR_DELIVERIES" "$POTS_SESSION_REPOSITORY/session/pots" || status=1
door_files_before=$(door_files_digest)
peer_host=$(in_session awk 'NR == 1 { print $1 }' "$DOOR_KNOWN_HOSTS" 2> /dev/null || true)
in_session bash "$TAILNET_ATTACKS" "$SANDBOX" "$peer_host" "$SESSION_TAILSCALE" "$DOOR_CLIENT_CONFIG" "$DOOR_PORT" "$DOOR_KNOWN_HOSTS" || status=1
in_session_as_root bash "$TAILNET_ATTACKS" "$SANDBOX" "$peer_host" "$SESSION_TAILSCALE" "$DOOR_CLIENT_CONFIG" "$DOOR_PORT" "$DOOR_KNOWN_HOSTS" || status=1
judge door-files-unchanged-by-session [ "$door_files_before" = "$(door_files_digest)" ] || status=1
judge vm-broker-identity-root-only identity_is_root_only || status=1
judge unprivileged-vm-user-cannot-read-broker-identity refused sandbox_vm sudo -u nobody cat "$POTS_VAULT_IDENTITY" || status=1
run_trusted probes/clone-trust.sh "$POTS_TRUSTED_SOURCE" "$POTS_TRUSTED_SIGNERS" "$POTS_SESSION_REPOSITORY" || status=1
in_session bash "$VAULT_ATTACKS" "$POTS_SESSION_REPOSITORY" "$POTS_SESSION_HOME" "$POTS_VAULT_IDENTITY" "$POTS_VAULT_SOCKET" "$SESSION_NODE" "$POTS_SESSION_CONFIGURATION" "$POTS_SESSION_USER" || status=1
in_session_as_root bash "$VAULT_ATTACKS" "$POTS_SESSION_REPOSITORY" "$POTS_SESSION_HOME" "$POTS_VAULT_IDENTITY" "$POTS_VAULT_SOCKET" "$SESSION_NODE" "$POTS_SESSION_CONFIGURATION" "$POTS_SESSION_USER" || status=1
in_session bash "$LANDING_ATTACKS" session "$POTS_SESSION_REPOSITORY/session/launch.env" || status=1
in_session_as_root bash "$LANDING_ATTACKS" session "$POTS_SESSION_REPOSITORY/session/launch.env" || status=1
run_trusted probes/landing-attacks.sh vm "$POTS_SESSION_REPOSITORY/session/launch.env" || status=1
judge jira-local-authentication in_session "$SESSION_NODE" "$JIRA_AUTHENTICATION" "$POTS_SESSION_REPOSITORY" || status=1
exit "$status"
