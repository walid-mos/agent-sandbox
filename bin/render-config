#!/usr/bin/env python3
import json
from pathlib import Path
import sys

USAGE = "usage: render-config sealskin|installed|binds"
if len(sys.argv) != 2:
    raise SystemExit(USAGE)
kind = sys.argv[1]
repository = Path(__file__).resolve().parents[1]


def assignments(path):
    return dict(line.split("=", 1) for line in (repository / path).read_text().splitlines() if line)


launch = assignments("session/launch.env")


# The session reads the pot's clone, its configuration and the vault broker's socket at the paths the VM keeps them at.
def session_binds():
    clone, configuration = launch["POTS_SESSION_REPOSITORY"], launch["POTS_SESSION_CONFIGURATION"]
    broker = str(Path(launch["POTS_VAULT_SOCKET"]).parent)
    shared = (clone, configuration, broker)
    if any(Path(launch["POTS_VAULT_IDENTITY"]).is_relative_to(path) for path in shared):
        raise SystemExit("render-config: POTS_VAULT_IDENTITY must stay outside every path the session mounts. Fix session/launch.env.")
    return [
        f"{clone}:{clone}:ro",
        f"{clone}/session/services.d:/custom-services.d:ro",
        f"{configuration}:{configuration}:ro",
        f"{broker}:{broker}:ro",
        f"{launch['POTS_INNER_DOCKER_VOLUME']}:/var/lib/docker:rw",
    ]


def with_launch_values(text):
    label_key, label_value = launch["POTS_SESSION_LABEL"].split("=", 1)
    values = {
        "SESSION_IMAGE": launch["POTS_SESSION_IMAGE"],
        "SESSION_RUNTIME": launch["POTS_SESSION_RUNTIME"],
        "SESSION_LABEL_KEY": label_key,
        "SESSION_LABEL_VALUE": label_value,
        "SESSION_START_DOCKER": launch["POTS_SESSION_START_DOCKER"],
    }
    for placeholder, value in values.items():
        text = text.replace(placeholder, value)
    return text


if kind == "sealskin":
    template = (repository / "sealskin/app-template.yml").read_text()
    print(with_launch_values(template).replace("SESSION_BINDS", json.dumps(",".join(session_binds()))), end="")
elif kind == "installed":
    print(with_launch_values((repository / "sealskin/installed_apps.yml").read_text()), end="")
elif kind == "binds":
    print("\n".join(session_binds()))
else:
    raise SystemExit(USAGE)
