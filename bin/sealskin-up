#!/bin/sh
set -eu
. "$(dirname "$0")/../lib/sandbox.sh"
require_sealskin

export SEALSKIN_PORT="$POTS_SERVER_PORT"
sandbox_docker compose --env-file "$POTS_REPO/vm/network.env" -f "$POTS_REPO/sealskin/compose.yaml" up -d --wait
sandbox_vm sudo env POTS_TRANSPORT=local python3 -I "$POTS_TRUSTED_LAUNCHER" sealskin-server-started
