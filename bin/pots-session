#!/bin/sh
set -eu
. "$(dirname "$0")/../lib/sandbox.sh"

LOCK=/run/pots-session.lock
LOCK_WAIT_SECONDS=300
LOCK_BUSY_STATUS=75
DOCKER_STOP_SECONDS=30
NEWLINE='
'

# Two callers can each find no session and launch one on the same home, so every launch runs in the VM and holds this lock there.
hold_lock() {
	[ "${POTS_SESSION_LOCK:-}" != held ] || return 0
	status=0
	env POTS_SESSION_LOCK=held flock --timeout "$LOCK_WAIT_SECONDS" --conflict-exit-code "$LOCK_BUSY_STATUS" "$LOCK" "$0" "$@" || status=$?
	[ "$status" -ne "$LOCK_BUSY_STATUS" ] || echo "pots-session: another launch kept $LOCK for $LOCK_WAIT_SECONDS seconds" >&2
	exit "$status"
}

api() {
	sandbox_docker exec -u "$POTS_SERVER_USER" "$POTS_SERVER_CONTAINER" sh -c 'printf "header = \"Authorization: Bearer %s\"\n" "$(cat /config/root_key)"' |
		curl --silent --show-error --fail --insecure --config - \
			--header 'X-SealSkin-App: other' --header 'content-type: application/json' "$@"
}

ensure_sealskin_home() {
	if api "$POTS_SERVER_URL/api/homedirs" | jq -e --arg home "$POTS_HOME_NAME" '.. | strings | select(. == $home)' > /dev/null; then
		return 0
	fi
	api --data "{\"home_name\":\"$POTS_HOME_NAME\"}" "$POTS_SERVER_URL/api/homedirs" > /dev/null
}

launch_sealskin() {
	wait_for_server
	ensure_sealskin_home
	api --data "{\"application_id\":\"$POTS_APP_ID\",\"home_name\":\"$POTS_HOME_NAME\"}" \
		"$POTS_SERVER_URL/api/launch/simple" > /dev/null
}

stop_sealskin() {
	sessions=$(api "$POTS_SERVER_URL/api/sessions")
	for session in $(echo "$sessions" | jq -r --arg app "$POTS_APP_ID" '.[] | select(.app_id == $app) | .session_id'); do
		api --request DELETE "$POTS_SERVER_URL/api/sessions/$session" > /dev/null
	done
}

launch_docker() {
	binds=$("$POTS_REPO/bin/render-config" binds)
	[ -n "$binds" ] || { echo 'pots-session: rendered binds are empty' >&2; exit 1; }
	set -- --volume "$POTS_HOME_VOLUME:$POTS_SESSION_HOME:rw"
	# One bind per line: a path with a space stays one argument, and no pattern in a path expands.
	set -f
	IFS=$NEWLINE
	for bind in $binds; do
		set -- "$@" --volume "$bind"
	done
	unset IFS
	set +f
	sandbox_docker run --detach --rm --name "$POTS_SESSION_CONTAINER" --runtime "$POTS_SESSION_RUNTIME" \
		--label "$POTS_SESSION_LABEL" --shm-size "$POTS_SESSION_SHM" \
		--env PUID=1000 --env PGID=1000 --env TZ="$POTS_SESSION_TIMEZONE" --env START_DOCKER="$POTS_SESSION_START_DOCKER" \
		"$@" "$POTS_SESSION_IMAGE" > /dev/null
}

stop_docker() {
	[ -z "$1" ] || sandbox_docker stop --time "$DOCKER_STOP_SECONDS" "$1" > /dev/null
}

launch() {
	"launch_$POTS_LAUNCHER"
}

stop() {
	stopping=$(session_container)
	"stop_$POTS_LAUNCHER" "$stopping" || return $?
	if [ -n "$stopping" ]; then
		sandbox_docker wait "$stopping" > /dev/null 2>&1 || true
	fi
}

ensure() {
	running=$(session_container)
	if [ -z "$running" ]; then
		"$POTS_REPO/vm/check-host-paths"
		launch
		running=$(session_container)
	fi
	[ -n "$running" ] || { echo "pots-session: the Pots session did not start" >&2; exit 1; }
	echo "$running"
}

if [ "$POTS_TRANSPORT" = provider ]; then
	sandbox_vm sudo env POTS_TRANSPORT=local "$POTS_SESSION_REPOSITORY/bin/pots-session" "$@"
	exit
fi
case "${1:-}" in
	ensure) hold_lock "$@"; ensure ;;
	name) session_container ;;
	stop) stop ;;
	restart) hold_lock "$@"; stop && ensure ;;
	*) echo "usage: pots-session ensure|name|stop|restart" >&2; exit 2 ;;
esac
