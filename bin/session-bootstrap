#!/bin/sh
set -eu
. "$(dirname "$0")/../lib/sandbox.sh"

session=$(running_session)

# hc reaches the session through its machine entry and copies itself there. The launcher and the watcher need it in the session.
install_hc() {
	if hc machine ls | jq --exit-status --arg name "$SANDBOX" 'any(.machines[]; .name == $name)' > /dev/null; then
		hc machine update "$SANDBOX" > /dev/null
	else
		hc machine add --install --name "$SANDBOX" --via "SANDBOX=$SANDBOX $POTS_REPO/bin/sandbox-exec sh -c" > /dev/null
	fi
}

if ! sandbox_vm sudo test -s "$POTS_VAULT_IDENTITY" ||
	! session_exec "$session" test -s "$POTS_SESSION_HOME/$POTS_SESSION_VAULT_DIRECTORY/$POTS_SESSION_VAULT_FILE" ||
	! session_exec "$session" test -s "$POTS_SESSION_HOME/$POTS_SESSION_VAULT_DIRECTORY/core-vault.json"; then
	"$POTS_REPO/bin/session-credentials"
fi
session_exec "$session" "$POTS_SESSION_REPOSITORY/session/bootstrap"
install_hc
restart_services "$session" pots-router pots-tailnet
# pots creates a bot only once its model answers, so the router gets its configuration first.
"$POTS_REPO/bin/router-seed"
"$POTS_REPO/bin/sandbox-exec" node "$POTS_SESSION_REPOSITORY/session/bot.mjs"
restart_services "$session" pots-gateway pots-watcher pots-sources
# The Factory bot's routine needs a running gateway, so it comes after the restart.
"$POTS_REPO/bin/sandbox-exec" node "$POTS_SESSION_REPOSITORY/session/factory-bot.mjs"
restart_services "$session" pots-factory
"$POTS_REPO/bin/sandbox-exec" node "$POTS_SESSION_REPOSITORY/session/discord-admin-bot.mjs"
"$POTS_REPO/bin/tailnet-up"
# Serving the pot's files needs the session node that tailnet-up joins, so it comes last.
"$POTS_REPO/bin/sandbox-exec" node "$POTS_SESSION_REPOSITORY/session/cloud.mjs"
restart_services "$session" pots-human-relay pots-discord-human
