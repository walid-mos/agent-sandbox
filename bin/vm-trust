#!/bin/sh
set -eu
. "$(dirname "$0")/../lib/sandbox.sh"
[ "$POTS_TRANSPORT" = provider ] || refuse_inside_vm vm-trust

SIGNERS="$POTS_RUNTIME/trusted-signers.asc"
FACTORY_SIGNERS="$POTS_RUNTIME/factory-signers.asc"
LAUNCHER_FILES="lib/trusted_source.py lib/signed_commit.py lib/source_refresh.py session/launch.env"

install_in_vm() {
	sandbox_vm sudo install -D -m 0644 -o root -g root /dev/stdin "$1" < "$2"
}

[ -f "$SIGNERS" ] || { echo "vm-trust: $SIGNERS is missing. Export the operator's public signing key: gpg --export --armor KEY_ID > $SIGNERS" >&2; exit 1; }
python3 -I "$POTS_REPO/lib/signed_commit.py" signers "$SIGNERS" > /dev/null
combined=$(mktemp)
trap 'rm -f "$combined"' EXIT INT TERM
cat "$SIGNERS" > "$combined"
printf '\n' >> "$combined"
if [ -f "$FACTORY_SIGNERS" ]; then
	python3 -I "$POTS_REPO/lib/signed_commit.py" signers "$FACTORY_SIGNERS" > /dev/null
	cat "$FACTORY_SIGNERS" >> "$combined"
fi
for file in $LAUNCHER_FILES; do
	install_in_vm "$POTS_TRUSTED_SOURCE/$file" "$POTS_REPO/$file"
done
install_in_vm "$POTS_TRUSTED_SIGNERS" "$combined"
