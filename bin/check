#!/bin/sh
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
node "$root/session/bot-secrets-config.mjs" "$root"/sandboxes.example/*/sandbox.json
python3 -I "$root/vm/vault_policy.py" "$root"/sandboxes.example/*/sandbox.json

compile_python() {
	PYTHONPYCACHEPREFIX="${TMPDIR:-/tmp}/agent-sandbox-pycache" python3 -m py_compile "$1"
}

for path in "$root"/bin/* "$root"/lib/*.sh "$root"/lib/providers/*.sh "$root"/proxmox/*.sh "$root"/lib/*.py "$root"/session/* "$root"/session/services.d/* "$root"/session/factory-image/* "$root"/mac/* "$root"/probes/* "$root"/vm/*; do
	[ -f "$path" ] || continue
	IFS= read -r interpreter < "$path" || true
	case "$interpreter" in
		'#!/bin/sh') sh -n "$path" ;;
		'#!/bin/bash') bash -n "$path" ;;
		'#!/usr/bin/env python3' | '#!/usr/bin/python3 -I') compile_python "$path" ;;
		'#!'*) echo "check: no syntax check for $interpreter in $path" >&2; exit 1 ;;
		*) case "$path" in
			*.sh) sh -n "$path" ;;
			*.py) compile_python "$path" ;;
		esac ;;
	esac
done
for path in "$root"/session/*.mjs "$root"/session/factory-image/*.mjs "$root"/mac/*.mjs "$root"/herdr/*.js; do
	node --check "$path"
done
# node --check rejects type annotations, so a TypeScript file is checked with its types stripped.
# The stripped source is captured first because sh has no pipefail to report a failed strip.
for path in "$root"/mac/*.ts; do
	plain=$(node --no-warnings --input-type=module -e 'import { stripTypeScriptTypes } from "node:module"; import { readFileSync } from "node:fs"; process.stdout.write(stripTypeScriptTypes(readFileSync(process.argv[1], "utf8")))' "$path")
	printf '%s\n' "$plain" | node --check --input-type=module
done
# The launcher decides which keys a sandbox needs: only SealSkin has a server.
for path in "$root"/sandboxes.example/*/sandbox.json; do
	jq -e '(.launcher // "docker") as $launcher | ($launcher == "docker") or ($launcher == "sealskin" and (.serverPort | type == "number"))' "$path" > /dev/null || { echo "check: $path needs launcher docker or sealskin, and serverPort for sealskin" >&2; exit 1; }
done
# A Proxmox example passes the rules lib/providers/proxmox.sh applies before reaching the hypervisor.
for path in "$root"/sandboxes.example/*/sandbox.json; do
	[ "$(jq -r '.provider // "colima"' "$path")" = proxmox ] || continue
	problems=$(jq -r --arg sandbox "$(basename "$(dirname "$path")")" -f "$root/proxmox/config.jq" "$path")
	[ -z "$problems" ] || { printf 'check: %s is not a valid Proxmox sandbox:\n%s\n' "$path" "$problems" >&2; exit 1; }
done
# The session holds the one allowed role, so only its shape is checked here.
for path in "$root"/sandboxes.example/*/sandbox.json; do
	jq -e '.role == null or (.role | type == "string")' "$path" > /dev/null || { echo "check: $path needs role as a string, when it has one" >&2; exit 1; }
done
# The VM's vault broker refuses a listed name that carries vault access, and each sandbox selects the catalog sources it fetches.
catalog=$(jq -c keys "$root/session/agent-sources.json")
for path in "$root"/sandboxes.example/*/sandbox.json; do
	jq -e --argjson catalog "$catalog" '([.owners[]?, (.secrets // {} | .[][]), (.onRequest // {} | .[][][])] | all(startswith("INFISICAL_") | not)) and (.sources | type == "array" and . - $catalog == [])' "$path" > /dev/null || { echo "check: $path lists a name starting with INFISICAL_, or does not select its sources as a list of session/agent-sources.json names" >&2; exit 1; }
done
node "$root/session/jira.mjs" check "$root"/sandboxes.example/*/sandbox.json
node "$root/session/contribution-policy.mjs" check "$root"/sandboxes.example/*/sandbox.json
for path in "$root"/sandboxes.example/*/sandbox.json "$root"/session/factory-repositories.json "$root"/session/agent-sources.json; do
	jq empty "$path"
done
for path in "$root"/sandboxes.example/*/sandbox.json; do
	jq -e '.doors == null or (.doors | type == "object" and all(.[]; type == "string"))' "$path" > /dev/null || { echo "check: $path needs doors as an object of pot names to one-line descriptions" >&2; exit 1; }
done
# Root in a VM runs the clone's code only through the trusted launcher: a unit starts the launcher or an installed copy, and a VM call runs the launcher, an installed copy or a literal management command.
python3 -I "$root/lib/check_vm_root.py"
# The generated pots policy grants only the ports lib/tailnet_node.py accepts, a door only along doors and their replies, and no Funnel, auto-approval or Tailscale SSH rule.
. "$root/vm/network.env"
settings=$(mktemp -d)
trap 'rm -rf "$settings"' EXIT INT TERM
printf '%s\n' '{"operatorLogin": "owner@example.com"}' > "$settings/tailnet.json"
policy=$(printf '%s\n' 'alpha beta' beta gamma | python3 "$root/lib/tailnet_policy.py" policy "$settings")
printf '%s\n' "$policy" | jq -e --arg door "tcp:$DOOR_PORT" '([.grants[].ip[]] - ["tcp:443", "tcp:10001-18790", "tcp:18792-65535", "tcp:22", $door] | length == 0) and ([.grants[].src[] | select(startswith("tag:") | not)] | unique == ["owner@example.com"]) and (has("nodeAttrs") or has("autoApprovers") or has("ssh") | not) and ([.grants[] | select(.ip == [$door]) | .src + .dst] == [["tag:pot-alpha", "tag:pot-beta-host"], ["tag:pot-beta", "tag:pot-alpha-host"]])' > /dev/null || { echo "check: lib/tailnet_policy.py grants more than the Serve, admin and door ports, to anyone but the human, a door off the doors, or nodeAttrs, autoApprovers or ssh" >&2; exit 1; }
! printf '%s\n' alpha | python3 "$root/lib/tailnet_policy.py" policy "$settings/absent" > /dev/null 2>&1 || { echo "check: lib/tailnet_policy.py prints a policy without an operator login" >&2; exit 1; }
! printf '%s\n' 'alpha alpha' | python3 "$root/lib/tailnet_policy.py" policy "$settings" > /dev/null 2>&1 || { echo "check: lib/tailnet_policy.py accepts a pot whose doors name itself" >&2; exit 1; }
! printf '%s\n' 'alpha keys' 'keys alpha' | python3 "$root/lib/tailnet_policy.py" policy "$settings" > /dev/null 2>&1 || { echo "check: lib/tailnet_policy.py accepts a pot named keys, whose session tag is the key-minting client's" >&2; exit 1; }
! printf '%s\n' 'alpha beta' | python3 "$root/lib/tailnet_policy.py" policy "$settings" > /dev/null 2>&1 || { echo "check: lib/tailnet_policy.py accepts a door to a pot outside the mesh" >&2; exit 1; }
# The operator's config sync carries the installed pane to their other Mac and leaves out a file named like a credential, so the pane fails there on the missing module.
skipped=$(cd "$root/herdr" && find . -type f | grep -iE 'credential|secret|token|password|cookie|auth|\.old-|\.reset-|\.corrupt-|\.(pem|key|p12|pfx|log|sqlite|db)$' || true)
if [ -n "$skipped" ]; then
	printf 'check: the config sync between Macs skips these pane files. Rename them:\n%s\n' "$skipped" >&2
	exit 1
fi
node --disable-warning=ExperimentalWarning --experimental-test-module-mocks --test "$root"/session/*.test.mjs
node --disable-warning=ExperimentalWarning --experimental-test-module-mocks --test "$root"/probes/human-*.mjs
PYTHONPYCACHEPREFIX="${TMPDIR:-/tmp}/agent-sandbox-pycache" python3 "$root/probes/human-door-vm.py"
node "$root/probes/dispatch-branches.mjs"
python3 -B "$root/probes/client-rules.py"
python3 -B "$root/probes/client-rules-activation.py"
python3 -B "$root/probes/repository-read-policy.py"
python3 -B "$root/probes/repository-read.py"
python3 -B "$root/probes/repository-read-supervision.py"
python3 -B "$root/probes/vault-broker-startup.py"
git -C "$root" diff --check
printf 'Shell, Python, JavaScript and sandbox configuration syntax, pane file name and diff whitespace checks passed.\n'
