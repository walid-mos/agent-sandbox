#!/bin/sh
set -eu
. "$(dirname "$0")/../lib/sandbox.sh"
[ "$POTS_TRANSPORT" = provider ] || { echo 'landing-key: run this from the operator Mac' >&2; exit 2; }
[ "$#" -eq 1 ] || { echo 'usage: landing-key create|export' >&2; exit 2; }
case "$1" in create | export) ;; *) echo 'usage: landing-key create|export' >&2; exit 2 ;; esac
run_trusted vm/landing-key "$@"
