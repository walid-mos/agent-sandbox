#!/bin/sh
set -eu
. "$(dirname "$0")/../lib/sandbox.sh"

put() {
	sandbox_docker exec -i -u "$POTS_SERVER_USER" "$POTS_SERVER_CONTAINER" sh -c 'cat > "$1.tmp" && mv "$1.tmp" "$1"' put "$1"
}

wait_for_server
"$POTS_REPO/bin/render-config" sealskin "$SANDBOX" | put "$POTS_SEALSKIN_CONFIG/app_templates/pots.yml"
put "$POTS_SEALSKIN_CONFIG/installed_apps.yml" < "$POTS_REPO/sealskin/installed_apps.yml"
