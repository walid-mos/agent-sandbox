#!/bin/sh
set -eu
. "$(dirname "$0")/../lib/sandbox.sh"

put() {
	sandbox_docker exec -i -u "$POTS_SERVER_USER" "$POTS_SERVER_CONTAINER" sh -c 'cat > "$1.tmp" && mv "$1.tmp" "$1"' put "$1"
}

template=$("$POTS_REPO/bin/render-config" sealskin "$SANDBOX")
[ -n "$template" ] || { echo 'sealskin-apply: rendered template is empty' >&2; exit 1; }
wait_for_server
printf '%s\n' "$template" | put "$POTS_SEALSKIN_CONFIG/app_templates/pots.yml"
put "$POTS_SEALSKIN_CONFIG/installed_apps.yml" < "$POTS_REPO/sealskin/installed_apps.yml"
# SealSkin reloads file edits asynchronously, so restart before a caller can launch with stale binds.
sandbox_docker restart "$POTS_SERVER_CONTAINER" > /dev/null
installed=$(sandbox_docker exec -u "$POTS_SERVER_USER" "$POTS_SERVER_CONTAINER" sh -c 'printf "header = \"Authorization: Bearer %s\"\n" "$(cat /config/root_key)"' |
	curl --silent --show-error --fail --insecure --config - \
		--retry "$SERVER_READY_ATTEMPTS" --retry-delay 2 --retry-all-errors \
		--header 'X-SealSkin-App: other' "$POTS_SERVER_URL/api/admin/apps/installed")
printf '%s\n' "$installed" | jq -e --arg app "$POTS_APP_ID" '.[] | select(.id == $app and .app_template == "Pots")' > /dev/null
