#!/bin/sh
set -eu
. "$(dirname "$0")/../lib/sandbox.sh"
[ "$POTS_TRANSPORT" = provider ] || refuse_inside_vm session-credentials

# The identity goes to a root-only file in the VM that the session never mounts. Only the VM's vault broker reads it.
# sh has no pipefail: a failed mint sends no lines, and the store refuses an incomplete identity.
node "$POTS_REPO/mac/mint-session-credentials.ts" | run_trusted vm/store-vault-identity
