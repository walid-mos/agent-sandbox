#!/bin/sh
set -eu
. "$(dirname "$0")/../lib/sandbox.sh"
[ "$POTS_TRANSPORT" = provider ] || refuse_inside_vm session-credentials

session=$(running_session)

# Each store refuses empty input, so a failed mint cannot replace an installed login.
node "$POTS_REPO/mac/mint-session-credentials.ts" broker "$session" | run_trusted vm/store-vault-identity
node "$POTS_REPO/mac/mint-session-credentials.ts" session "$session" |
	session_exec --interactive "$session" python3 "$POTS_SESSION_REPOSITORY/session/store-identity"
