#!/usr/bin/env python3
import fcntl
import os
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from factory_root import fingerprints, gpg, private_directory
from factory_socket import Refused
from landing import IDENTITY_EMAIL, IDENTITY_NAME, fingerprint
from launch import LAUNCH


def main():
    if os.geteuid() != 0 or sys.argv[1:] not in (["create"], ["export"]):
        raise Refused("usage: VM root runs landing-key create|export from the operator's Mac.")
    home = Path(LAUNCH["POTS_LANDING_KEY_HOME"])
    private_directory(home)
    with (home / "operator.lock").open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if sys.argv[1] == "create":
            if fingerprints(gpg(home, "--with-colons", "--list-secret-keys")):
                raise Refused("landing-key: a key already exists. Export it instead of replacing it.")
            gpg(home, "--pinentry-mode", "loopback", "--passphrase", "", "--quick-generate-key", f"{IDENTITY_NAME} <{IDENTITY_EMAIL}>", "ed25519", "sign", "0")
            print(fingerprint(home))
            return
        sys.stdout.buffer.write(gpg(home, "--armor", "--export", fingerprint(home)))


if __name__ == "__main__":
    try:
        main()
    except (Refused, OSError) as error:
        raise SystemExit(str(error)) from None
