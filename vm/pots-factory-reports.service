[Unit]
Description=Deliver the isolated factory's reports to this VM's session
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
ExecStart=/usr/bin/python3 -I /usr/local/lib/agent-sandbox/lib/trusted_source.py run vm/factory-reports
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/run/pots-factory-reports

[Install]
WantedBy=multi-user.target
