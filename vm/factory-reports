#!/usr/bin/env python3
import json
import os
from pathlib import Path
import re
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from factory_root import ENVIRONMENT, execute
from factory_socket import REQUEST_LIMIT, Refused, serve
from launch import LAUNCH



def report(request):
    if not isinstance(request, dict) or set(request) != {"id", "text"}:
        raise Refused("factory-reports: expected a report ID and plain text only.")
    if not isinstance(request["id"], str) or not re.fullmatch(r"[a-zA-Z0-9_.-]{1,240}", request["id"]):
        raise Refused("factory-reports: malformed report ID.")
    if not isinstance(request["text"], str) or not request["text"] or len(request["text"].encode()) > REQUEST_LIMIT // 2:
        raise Refused("factory-reports: expected bounded report text.")
    configuration = json.loads((Path(LAUNCH["POTS_SESSION_CONFIGURATION"]) / "sandbox.json").read_text())
    bot = configuration["bot"].lower()
    if not re.fullmatch(r"[a-z0-9-]+", bot):
        raise Refused("factory-reports: invalid configured Principal.")
    containers = execute(["/usr/bin/docker", "ps", "--filter", f"label={LAUNCH['POTS_SESSION_LABEL']}", "--format", "{{.ID}}"], environment=ENVIRONMENT).decode().split()
    if len(containers) != 1:
        raise Refused("factory-reports: expected one running worker session.")
    execute(["/usr/bin/docker", "exec", "--user", LAUNCH["POTS_SESSION_USER"], "--env", f"HOME={LAUNCH['POTS_SESSION_HOME']}", containers[0], f"{LAUNCH['POTS_SESSION_REPOSITORY']}/session/with-vault", "pots", "wake", "--bot", bot, "--from", "pr-factory", "--id", request["id"], "--note", request["text"]])
    return {}


if __name__ == "__main__":
    if os.geteuid() != 0:
        raise SystemExit("factory-reports runs as VM root.")
    serve(LAUNCH["POTS_FACTORY_REPORT_SOCKET"], "factory-reports", REQUEST_LIMIT, report, "factory-reports: report could not be delivered.")
