#!/bin/sh
set -eu
[ $# -eq 2 ] || { echo 'usage: session-keys SANDBOX ENTRY_COMMAND < authorized_keys' >&2; exit 2; }
sandbox=$1
enter=$2

# Both words land inside a quoted authorized_keys option, where a space, a quote or an expansion would change the forced command.
for word in "$sandbox" "$enter"; do
	case "$word" in
		'' | *[!A-Za-z0-9_./=:@%+,~-]*) echo "vm/session-keys: '$word' cannot go into a forced command; it may hold letters, digits and _ . / = : @ % + , ~ - only" >&2; exit 2 ;;
	esac
done
umask 077
# Lima rewrites authorized_keys at each boot and leaves this second file alone. A key listed here runs its shell line in the session and nothing in the VM.
awk -v sandbox="$sandbox" -v enter="$enter" '/^(ssh|ecdsa|sk)-/ {
	print "restrict,command=\"SANDBOX=" sandbox " " enter " sh -c \\\"$SSH_ORIGINAL_COMMAND\\\"\" " $0
}' > "$HOME/.ssh/authorized_keys2"
