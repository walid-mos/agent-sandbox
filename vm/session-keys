#!/bin/sh
set -eu
. "$(dirname "$0")/../session/launch.env"
[ $# -ge 2 ] || { echo 'usage: session-keys SANDBOX SCRIPT [VARIABLE=VALUE...] < authorized_keys' >&2; exit 2; }
sandbox=$1
script=$2
shift 2

# Every word lands inside a quoted authorized_keys option, where a space, a quote or an expansion would change the forced command.
for word in "$sandbox" "$script" "$@"; do
	case "$word" in
		'' | *[!A-Za-z0-9_./=:@%+,~-]*) echo "vm/session-keys: '$word' cannot go into a forced command; it may hold letters, digits and _ . / = : @ % + , ~ - only" >&2; exit 2 ;;
	esac
done
for assignment in "$@"; do
	name=${assignment%%=*}
	case "$name" in
		"$assignment" | '' | [0-9]* | *[!A-Z0-9_]*) echo "vm/session-keys: '$assignment' is not a VARIABLE=VALUE word" >&2; exit 2 ;;
	esac
done
environment="SANDBOX=$sandbox${*:+ $*}"
# SCRIPT is a path in the clone, which the forced command runs only through the launcher outside it, once that launcher has verified the clone.
enter="/usr/bin/python3 -I $POTS_TRUSTED_SOURCE/lib/trusted_source.py run $script"
umask 077
mkdir -p "$HOME/.ssh"
# Lima rewrites authorized_keys at each boot and leaves this second file alone. A key listed here runs its shell line in the session and nothing in the VM.
awk -v environment="$environment" -v enter="$enter" '/^(ssh|ecdsa|sk)-/ {
	print "restrict,command=\"" environment " " enter " sh -c \\\"$SSH_ORIGINAL_COMMAND\\\"\" " $0
}' > "$HOME/.ssh/authorized_keys2"
