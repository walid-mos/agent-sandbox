[Unit]
Description=Pots door: sshd for other pots on the tailnet address
Requires=tailscaled.service pots-firewall.service
After=tailscaled.service pots-firewall.service

[Service]
ExecStart=/usr/local/sbin/pots-door-serve
Restart=on-failure
RestartSec=10
OOMScoreAdjust=-500
# A restart replaces the listener and leaves deliveries under way to finish.
KillMode=process

[Install]
WantedBy=multi-user.target
