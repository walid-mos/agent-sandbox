[Unit]
Description=Raise the shields of this VM's pot nodes when the tailnet policy opens more than the pots policy
Requires=tailscaled.service
After=tailscaled.service docker.service
OnFailure=pots-shields-up.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/lib/agent-sandbox/lib/trusted_source.py run vm/tailnet-guard
OOMScoreAdjust=-500
TimeoutStartSec=2min
