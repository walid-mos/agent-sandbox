#!/usr/bin/env python3
import os
from pathlib import Path
import re
import sys
import tempfile

sys.path.insert(0, str(Path(__file__).resolve().parent))
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from factory_root import private_directory
from factory_state import FACTORY_SEED, FACTORY_STATE
from factory_socket import Refused

SEED_LIMIT = 16 * 1024 * 1024
PASSPHRASE = re.compile(rb"[0-9a-f]{48}\n")


def main():
    if os.geteuid() != 0 or len(sys.argv) != 1:
        raise Refused("factory-seed: VM root accepts the operator's seed on stdin only.")
    passphrase = sys.stdin.buffer.readline(50)
    seed = sys.stdin.buffer.read(SEED_LIMIT + 1)
    if not PASSPHRASE.fullmatch(passphrase) or not seed or len(seed) > SEED_LIMIT:
        raise Refused("factory-seed: malformed or oversized operator seed. Nothing was installed.")
    private_directory(FACTORY_STATE)
    if FACTORY_SEED.exists():
        raise Refused("factory-seed: a seed is already installed. Preserve it and use a separately reviewed rotation.")
    with tempfile.TemporaryDirectory(prefix=f".{FACTORY_SEED.name}-", dir=FACTORY_STATE) as staging:
        pending = Path(staging) / FACTORY_SEED.name
        pending.mkdir(mode=0o700)
        (pending / "seed").write_bytes(seed)
        (pending / "passphrase").write_bytes(passphrase)
        (pending / "seed").chmod(0o600)
        (pending / "passphrase").chmod(0o600)
        pending.rename(FACTORY_SEED)
    print("factory-seed: operator seed stored outside the session. No factory key was created.")


if __name__ == "__main__":
    try:
        main()
    except (Refused, OSError) as error:
        raise SystemExit(str(error)) from None
